APP_ENV=development
# Emulator 10.0.2.2 reaches host loopback; 127.0.0.1:8080 is enough.
# Physical device needs HTTP_ADDR=0.0.0.0:8080 and the machine LAN URL.
HTTP_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://sandbox:change-me@localhost:5432/sandbox?sslmode=disable
DB_MAX_CONNS=20
LOG_LEVEL=info

# Kie.ai fronts several providers with one key. The primary model speaks the
# Anthropic Messages schema at /claude/v1/messages; the fallback speaks the
# Responses schema at /codex/v1/responses and is used whenever the primary is
# unavailable. Leave KIE_API_KEY empty to fall back to a direct OpenAI key.
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_MODEL=claude-opus-5
KIE_FALLBACK_MODEL=gpt-5-6-terra
# low | medium | high | xhigh
KIE_REASONING_EFFORT=low
KIE_MAX_TOKENS=16000
KIE_TIMEOUT_SECONDS=300

OPENAI_API_KEY=
OPENAI_MODEL=
MODELS_CATALOG_BASE_URL=
MODELS_CATALOG_API_KEY=

# Confirmation codes for sign-up, passwordless login, and password reset.
# Port 465 uses implicit TLS; any other port negotiates STARTTLS.
# Without these the codes are written to the log instead of being sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=GameDev

AUTH_ACCESS_TTL_SECONDS=86400
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=900
AUTH_CODE_ATTEMPTS=5
# May be disabled only in development.
AUTH_REQUIRE_VERIFIED_EMAIL=true

# Agent conveyor: architect, game designer, developer, tester, reviewer, auditor.
AI_PIPELINE_WORKERS=2
AI_MAX_REPAIRS=2
AI_STEP_TIMEOUT_SECONDS=330
AI_JOB_TIMEOUT_SECONDS=1800

# Honour X-Forwarded-For for rate limiting. Enable only behind a proxy that
# rewrites the header; a direct client can otherwise forge it.
TRUST_PROXY_HEADERS=false
